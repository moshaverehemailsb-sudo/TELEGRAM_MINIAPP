# Copy to backend/.env and fill in real values. Never commit .env.
APP_ENV=development

# Neon connection string (keep sslmode=require)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Token from @BotFather. Used only on the server to verify Telegram initData.
TELEGRAM_BOT_TOKEN=

# Max age (seconds) of Telegram initData before it is rejected
TELEGRAM_INIT_DATA_MAX_AGE=86400

# Comma-separated numeric Telegram user IDs of advisors
ADVISOR_TELEGRAM_IDS=

# Local development only. Must stay false in production.
ALLOW_DEV_AUTH=false